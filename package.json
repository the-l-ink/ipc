{
  "name": "@the-link/ipc",
  "version": "0.1.0",
  "description": "Local IPC adapter for The Link.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "author": "Zohayr SLILEH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-l-ink/ipc.git"
  },
  "homepage": "https://the-l.ink",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "check": "tsc --noEmit",
    "test": "bun test",
    "build": "node --run clean && tsc",
    "verify:package": "npm pack --dry-run --ignore-scripts",
    "verify": "node --run check && node --run test && node --run build && node --run verify:package",
    "prepack": "node --run build"
  },
  "dependencies": {
    "@the-link/core": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^6.0.3"
  }
}
